<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle (#282, apps/mac/app/Updater.swift). The rest of the Info.plist is generated from the build
	     settings (GENERATE_INFOPLIST_FILE) and merged with this. Hosting and the key are build
	     settings from apps/config/Signing.xcconfig. -->
	<key>SUFeedURL</key>
	<string>$(OBY_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(OBY_SPARKLE_PUBLIC_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>21600</integer>
	<!-- Remote access's control plane (Engine/ControlPlane.swift), from apps/config/Signing.xcconfig. -->
	<key>ObyControlPlaneURL</key>
	<string>$(OBY_CONTROL_PLANE_URL)</string>
	<!-- The Obysphere server (apps/mac/app/Sphere.swift, SphereModel.server), from apps/config/Signing.xcconfig. -->
	<key>ObySphereURL</key>
	<string>$(OBY_SPHERE_URL)</string>
	<!-- oby://join/<host>#…: an Obysphere's join page's Open in Oby (apps/mac/app/ObyApp.swift, AppDelegate). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.deskree.oby.join</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>oby</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
