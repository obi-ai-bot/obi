<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- The app's own group first, so items saved with no group stay where they were (the Mac's device
	     token, the relay's pushSecret); the second is the one the push extension shares (apps/ios/push). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(OBY_IPHONE_BUNDLE_ID)</string>
		<string>$(AppIdentifierPrefix)$(OBY_IPHONE_BUNDLE_ID).push</string>
	</array>
</dict>
</plist>
