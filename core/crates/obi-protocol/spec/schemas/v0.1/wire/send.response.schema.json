{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/send.response.schema.json",
  "title": "POST /v0.1/spheres/{sphere}/messages answer",
  "description": "The message was checked, appended to the audit chain and queued for its recipient.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "seq",
    "entry_hash",
    "recorded_at"
  ],
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "entry_hash": {
      "$ref": "../common.schema.json#/$defs/hash"
    },
    "recorded_at": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    }
  }
}
