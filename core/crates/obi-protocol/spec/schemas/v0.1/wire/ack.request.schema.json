{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/ack.request.schema.json",
  "title": "POST /v0.1/spheres/{sphere}/deliveries/ack request",
  "description": "Acknowledge deliveries the Obi has recorded durably.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delivery_ids"
  ],
  "properties": {
    "delivery_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/uuid"
      }
    }
  }
}
