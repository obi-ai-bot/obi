{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/create-sphere.request.schema.json",
  "title": "POST /v0.1/spheres request",
  "description": "Create a Sphere (a team). Operator only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sphere",
    "name",
    "admin"
  ],
  "properties": {
    "sphere": {
      "$ref": "../common.schema.json#/$defs/sphere_id"
    },
    "name": {
      "$ref": "../common.schema.json#/$defs/line_text",
      "x-obi-text": "data",
      "minLength": 1,
      "maxLength": 100
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "owner_key"
      ],
      "properties": {
        "owner": {
          "$ref": "../common.schema.json#/$defs/owner_id"
        },
        "owner_key": {
          "$ref": "../common.schema.json#/$defs/public_key"
        }
      }
    }
  }
}
