{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/token.response.schema.json",
  "title": "POST /v0.1/oauth/token answer",
  "description": "RFC 8693 token exchange response. The access token is opaque.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "access_token",
    "issued_token_type",
    "token_type",
    "expires_in",
    "scope"
  ],
  "properties": {
    "access_token": {
      "type": "string",
      "minLength": 32,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "issued_token_type": {
      "const": "urn:ietf:params:oauth:token-type:access_token"
    },
    "token_type": {
      "const": "Bearer"
    },
    "expires_in": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[a-z_:]+( [a-z_:]+)*$"
    }
  }
}
