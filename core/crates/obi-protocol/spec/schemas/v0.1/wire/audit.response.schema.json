{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/audit.response.schema.json",
  "title": "GET /v0.1/spheres/{sphere}/audit answer",
  "description": "A page of the audit chain, in seq order, and the chain's head now.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sphere",
    "entries",
    "head"
  ],
  "properties": {
    "sphere": {
      "$ref": "../common.schema.json#/$defs/sphere_id"
    },
    "entries": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "../audit-entry.schema.json"
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "hash"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hash": {
          "$ref": "../common.schema.json#/$defs/hash"
        }
      }
    }
  }
}
