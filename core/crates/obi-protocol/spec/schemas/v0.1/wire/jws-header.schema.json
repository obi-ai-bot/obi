{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/jws-header.schema.json",
  "title": "JWS protected header",
  "description": "The protected header of every JWS in this protocol: owner and Obi assertions (typ JWT) and card signatures (typ JOSE).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alg",
    "kid",
    "typ"
  ],
  "properties": {
    "alg": {
      "const": "EdDSA"
    },
    "kid": {
      "$ref": "../common.schema.json#/$defs/key_id"
    },
    "typ": {
      "enum": [
        "JWT",
        "JOSE"
      ]
    }
  }
}
