{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/actor.claims.schema.json",
  "title": "Obi assertion claims (actor_token)",
  "description": "The JWT payload an Obi signs with its own key to prove it is the actor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iss",
    "sub",
    "aud",
    "iat",
    "exp",
    "jti"
  ],
  "properties": {
    "iss": {
      "$ref": "../common.schema.json#/$defs/obi_id"
    },
    "sub": {
      "$ref": "../common.schema.json#/$defs/obi_id"
    },
    "aud": {
      "type": "string",
      "minLength": 12,
      "maxLength": 75,
      "pattern": "^obi-sphere:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jti": {
      "$ref": "../common.schema.json#/$defs/uuid"
    }
  }
}
