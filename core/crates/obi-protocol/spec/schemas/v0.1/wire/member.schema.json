{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/member.schema.json",
  "title": "Member",
  "description": "One Obi in the directory, with its current card and every key it ever had.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "obi",
    "owner",
    "owner_key",
    "owner_key_id",
    "status",
    "joined_at",
    "card",
    "keys"
  ],
  "properties": {
    "obi": {
      "$ref": "../common.schema.json#/$defs/obi_id"
    },
    "owner": {
      "$ref": "../common.schema.json#/$defs/owner_id"
    },
    "owner_key": {
      "$ref": "../common.schema.json#/$defs/public_key"
    },
    "owner_key_id": {
      "$ref": "../common.schema.json#/$defs/key_id"
    },
    "status": {
      "enum": [
        "active",
        "revoked"
      ]
    },
    "joined_at": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    },
    "revoked_at": {
      "$ref": "../common.schema.json#/$defs/timestamp",
      "description": "When the member was revoked: present exactly when status is revoked (sphere-api.md, \"Directory\")."
    },
    "card": {
      "$ref": "../agent-card.schema.json"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "public_key",
          "valid_from_seq",
          "valid_until_seq"
        ],
        "properties": {
          "key_id": {
            "$ref": "../common.schema.json#/$defs/key_id"
          },
          "public_key": {
            "$ref": "../common.schema.json#/$defs/public_key"
          },
          "valid_from_seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "The first audit seq this key may sign."
          },
          "valid_until_seq": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "The last audit seq this key may sign, or null while it is current."
          }
        }
      }
    },
    "runner": {
      "$ref": "../runner-status.schema.json",
      "description": "The member's runner status, only when it is offered to the caller's owner and hasn't expired (sphere-api.md section 6.4)."
    }
  }
}
