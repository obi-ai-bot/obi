{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/policy.schema.json",
  "title": "Policy",
  "description": "Who may send which request to whom: allow rules only; a request no rule allows is refused. `version` grows by 1 with every change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "rules",
    "updated_at"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "rules": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from_owner",
          "to_owner",
          "actions",
          "repos"
        ],
        "properties": {
          "id": {
            "$ref": "../common.schema.json#/$defs/rule_id"
          },
          "from_owner": {
            "anyOf": [
              {
                "const": "*"
              },
              {
                "$ref": "../common.schema.json#/$defs/owner_id"
              }
            ]
          },
          "to_owner": {
            "anyOf": [
              {
                "const": "*"
              },
              {
                "$ref": "../common.schema.json#/$defs/owner_id"
              }
            ]
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "$ref": "../common.schema.json#/$defs/request_type"
            }
          },
          "repos": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^(\\*|[A-Za-z0-9]([A-Za-z0-9-]{0,38})/(\\*|[A-Za-z0-9_][A-Za-z0-9._-]{0,99}))$"
            }
          }
        }
      }
    },
    "updated_at": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    }
  }
}
