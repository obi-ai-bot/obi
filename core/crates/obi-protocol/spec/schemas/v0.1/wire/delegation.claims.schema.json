{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/delegation.claims.schema.json",
  "title": "Owner assertion claims (subject_token)",
  "description": "The JWT payload an owner signs: a delegation to one Obi (with may_act), or a short assertion for the owner's own token (without).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iss",
    "sub",
    "aud",
    "iat",
    "exp",
    "jti",
    "scope"
  ],
  "properties": {
    "iss": {
      "$ref": "../common.schema.json#/$defs/owner_id"
    },
    "sub": {
      "$ref": "../common.schema.json#/$defs/owner_id"
    },
    "aud": {
      "type": "string",
      "minLength": 12,
      "maxLength": 75,
      "pattern": "^obi-sphere:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jti": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[a-z_:]+( [a-z_:]+)*$"
    },
    "may_act": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sub"
      ],
      "properties": {
        "sub": {
          "$ref": "../common.schema.json#/$defs/obi_id"
        }
      }
    }
  }
}
