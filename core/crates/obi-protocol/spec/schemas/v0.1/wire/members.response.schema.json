{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/members.response.schema.json",
  "title": "GET /v0.1/spheres/{sphere}/members answer",
  "description": "The directory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sphere",
    "members"
  ],
  "properties": {
    "sphere": {
      "$ref": "../common.schema.json#/$defs/sphere_id"
    },
    "members": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "member.schema.json"
      }
    }
  }
}
