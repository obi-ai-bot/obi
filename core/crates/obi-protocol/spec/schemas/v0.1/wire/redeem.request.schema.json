{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/redeem.request.schema.json",
  "title": "POST /v0.1/spheres/{sphere}/invitations/{invitation_id}/redeem request",
  "description": "Pair an Obi: redeem its invitation with its owner-signed agent card. The secret is the authentication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "secret",
    "owner_key",
    "card"
  ],
  "properties": {
    "secret": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "owner_key": {
      "$ref": "../common.schema.json#/$defs/public_key"
    },
    "card": {
      "$ref": "../agent-card.schema.json"
    }
  }
}
