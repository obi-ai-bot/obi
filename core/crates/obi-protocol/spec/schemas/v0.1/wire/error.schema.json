{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/error.schema.json",
  "title": "Sphere error",
  "description": "Every non-2xx answer of the Sphere API except the token endpoint (which answers OAuth errors, RFC 6749 section 5.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "bad_request",
            "invalid_envelope",
            "wrong_sphere",
            "bad_signature",
            "unknown_key",
            "expired",
            "clock_skew",
            "duplicate",
            "policy_denied",
            "unknown_recipient",
            "recipient_revoked",
            "bad_reply",
            "unauthorized",
            "insufficient_scope",
            "forbidden",
            "not_found",
            "conflict",
            "invitation_invalid",
            "card_invalid",
            "payload_too_large",
            "rate_limited",
            "internal"
          ]
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/line_text",
          "x-obi-text": "data",
          "minLength": 1,
          "maxLength": 500
        },
        "details": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "../common.schema.json#/$defs/line_text",
            "x-obi-text": "data",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
