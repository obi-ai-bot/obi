{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/invitation.request.schema.json",
  "title": "POST /v0.1/spheres/{sphere}/invitations request",
  "description": "Invite one Obi of one owner. Admin only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "obi",
    "expires_in"
  ],
  "properties": {
    "owner": {
      "$ref": "../common.schema.json#/$defs/owner_id"
    },
    "obi": {
      "$ref": "../common.schema.json#/$defs/obi_id"
    },
    "expires_in": {
      "type": "integer",
      "minimum": 60,
      "maximum": 2592000
    }
  }
}
