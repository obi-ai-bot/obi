{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/audit-entry.schema.json",
  "title": "Audit chain entry v0.1",
  "description": "One entry of a Sphere's audit chain (spec/sphere-api.md, \"Audit chain\"). `hash` is SHA-256 over the hashing input of every other field; `prev` is the previous entry's hash (64 zeros for seq 1). The envelope is exactly as the sender signed it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sphere",
    "seq",
    "prev",
    "recorded_at",
    "envelope",
    "hash"
  ],
  "properties": {
    "sphere": {
      "$ref": "common.schema.json#/$defs/sphere_id"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "prev": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "envelope": {
      "$ref": "envelope.schema.json"
    },
    "hash": {
      "$ref": "common.schema.json#/$defs/hash"
    }
  }
}
