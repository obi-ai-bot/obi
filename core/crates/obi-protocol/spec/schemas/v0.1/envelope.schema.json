{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/envelope.schema.json",
  "title": "Obi-to-Obi envelope v0.1",
  "description": "Every message between Obis is one envelope carrying one typed action in `body`. The signature covers every other field (spec/protocol.md, \"Signing\"). There is no free-text message type, and no field outside this schema is allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "type",
    "from",
    "to",
    "sphere",
    "correlation_id",
    "created_at",
    "expires_at",
    "key_id",
    "body",
    "signature"
  ],
  "properties": {
    "protocol": {
      "$ref": "common.schema.json#/$defs/protocol"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Unique id of this message."
    },
    "type": {
      "$ref": "common.schema.json#/$defs/action_type"
    },
    "from": {
      "$ref": "common.schema.json#/$defs/obi_id",
      "description": "The sending Obi."
    },
    "to": {
      "$ref": "common.schema.json#/$defs/obi_id",
      "description": "The receiving Obi."
    },
    "sphere": {
      "$ref": "common.schema.json#/$defs/sphere_id",
      "description": "The Sphere this message travels in."
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "The exchange this message belongs to: on a request, its own id; on a reply, the request's id."
    },
    "in_reply_to": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "On a reply only: the id of the request it answers."
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp",
      "description": "After this time the receiver must not act on the message."
    },
    "key_id": {
      "$ref": "common.schema.json#/$defs/key_id",
      "description": "The sender's signing key, as its agent card publishes it."
    },
    "body": {
      "type": "object",
      "description": "The action's fields: the schema in actions/<type>.schema.json."
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature",
      "description": "Ed25519 over the signing input of every other field."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "$ref": "common.schema.json#/$defs/request_type"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "in_reply_to"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "status",
              "accept",
              "decline",
              "result",
              "answer",
              "run_progress",
              "run_return",
              "run_cancel"
            ]
          }
        }
      },
      "then": {
        "required": [
          "in_reply_to"
        ]
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "review_request"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "actions/review_request.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "question"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "actions/question.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "handoff"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "actions/handoff.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "status"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "actions/status.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "accept"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "actions/accept.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "decline"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "actions/decline.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "result"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "actions/result.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "answer"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "actions/answer.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "run_request"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "actions/run_request.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "run_progress"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "actions/run_progress.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "run_return"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "actions/run_return.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "run_cancel"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "actions/run_cancel.schema.json"
          }
        }
      }
    }
  ]
}
