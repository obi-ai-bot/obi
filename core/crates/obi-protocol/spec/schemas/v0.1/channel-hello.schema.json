{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/channel-hello.schema.json",
  "title": "Job channel hello",
  "description": "The first frame each side sends on a run_request's job channel (protocol.md section 13): a new X25519 key, signed by the Obi's own key and bound to the exchange.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "sphere",
    "correlation_id",
    "obi",
    "role",
    "x25519",
    "key_id",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "obi/0.1 channel"
    },
    "sphere": {
      "$ref": "common.schema.json#/$defs/sphere_id"
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "obi": {
      "$ref": "common.schema.json#/$defs/obi_id"
    },
    "role": {
      "enum": [
        "guest",
        "host"
      ]
    },
    "x25519": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "key_id": {
      "$ref": "common.schema.json#/$defs/key_id"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  }
}
