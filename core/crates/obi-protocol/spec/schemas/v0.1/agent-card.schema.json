{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/agent-card.schema.json",
  "title": "Obi agent card v0.1 (an A2A AgentCard profile)",
  "description": "The A2A AgentCard an Obi publishes in its Sphere, with the Obi extension and exactly one signature by its owner's key (spec/identity.md). Only the A2A fields listed here are allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "name",
    "description",
    "url",
    "preferredTransport",
    "version",
    "capabilities",
    "defaultInputModes",
    "defaultOutputModes",
    "skills",
    "signatures"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.3.0",
      "description": "The A2A protocol version the card follows."
    },
    "name": {
      "$ref": "common.schema.json#/$defs/line_text",
      "x-obi-text": "data",
      "minLength": 1,
      "maxLength": 100,
      "description": "What to call this Obi, as its owner wrote it."
    },
    "description": {
      "$ref": "common.schema.json#/$defs/line_text",
      "x-obi-text": "data",
      "minLength": 1,
      "maxLength": 300
    },
    "url": {
      "type": "string",
      "minLength": 12,
      "maxLength": 500,
      "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?/v0\\.1/spheres/[a-z0-9-]{1,63}/members/[a-z0-9-]{1,63}$",
      "description": "This Obi's entry in its Sphere's directory. Messages reach it through the Sphere relay."
    },
    "preferredTransport": {
      "const": "HTTP+JSON"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z.+-]{1,64}$",
      "description": "The Obi implementation's version."
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization"
      ],
      "properties": {
        "organization": {
          "$ref": "common.schema.json#/$defs/line_text",
          "x-obi-text": "data",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500,
          "pattern": "^https://[^\\s]{1,492}$"
        }
      }
    },
    "documentationUrl": {
      "type": "string",
      "minLength": 8,
      "maxLength": 500,
      "pattern": "^https://[^\\s]{1,492}$"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streaming",
        "pushNotifications",
        "extensions"
      ],
      "properties": {
        "streaming": {
          "const": false
        },
        "pushNotifications": {
          "const": false
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/obi_extension"
          }
        }
      }
    },
    "defaultInputModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "application/json"
      }
    },
    "defaultOutputModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "application/json"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/skill"
      },
      "description": "One skill per request type the Obi accepts, the same set as the extension's `accepts`."
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/card_signature"
      }
    }
  },
  "$defs": {
    "obi_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "required",
        "params"
      ],
      "properties": {
        "uri": {
          "const": "urn:obi-sphere:ext:obi:0.1"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/line_text",
          "x-obi-text": "data",
          "minLength": 1,
          "maxLength": 300
        },
        "required": {
          "const": true
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "sphere",
            "obi_id",
            "owner",
            "owner_key",
            "key_id",
            "public_key",
            "accepts",
            "card_seq",
            "issued_at"
          ],
          "properties": {
            "protocol": {
              "$ref": "common.schema.json#/$defs/protocol"
            },
            "sphere": {
              "$ref": "common.schema.json#/$defs/sphere_id"
            },
            "obi_id": {
              "$ref": "common.schema.json#/$defs/obi_id"
            },
            "owner": {
              "$ref": "common.schema.json#/$defs/owner_id"
            },
            "owner_key": {
              "$ref": "common.schema.json#/$defs/public_key",
              "description": "The owner's Ed25519 public key, which signs this card."
            },
            "key_id": {
              "$ref": "common.schema.json#/$defs/key_id",
              "description": "The Obi's signing key id: what its envelopes carry in `key_id`."
            },
            "public_key": {
              "$ref": "common.schema.json#/$defs/public_key",
              "description": "The Obi's Ed25519 public key."
            },
            "accepts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/request_type"
              },
              "description": "The request types this Obi accepts. Replies are always accepted."
            },
            "card_seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000,
              "description": "Grows by at least 1 with every card the owner issues for this Obi in this Sphere."
            },
            "issued_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "tags"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/request_type"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/line_text",
          "x-obi-text": "data",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "$ref": "common.schema.json#/$defs/line_text",
          "x-obi-text": "data",
          "minLength": 1,
          "maxLength": 300
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "obi-action"
          }
        }
      }
    },
    "card_signature": {
      "description": "A2A AgentCardSignature: a JWS (RFC 7515) with detached payload. `protected` is the base64url protected header; the payload is the JCS form of the card without `signatures`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected",
        "signature"
      ],
      "properties": {
        "protected": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1000,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "signature": {
          "$ref": "common.schema.json#/$defs/signature"
        }
      }
    }
  }
}
