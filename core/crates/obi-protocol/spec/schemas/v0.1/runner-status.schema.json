{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/runner-status.schema.json",
  "title": "Runner status",
  "description": "What an Obi's Mac offers other members now (protocol.md section 14): signed by the Obi, published in the directory, shown only to the owners `for` names. It never says whether its owner is at the Mac.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "sphere",
    "obi",
    "free",
    "slots",
    "size",
    "agents",
    "kinds",
    "for",
    "created_at",
    "expires_at",
    "key_id",
    "signature"
  ],
  "properties": {
    "protocol": {
      "$ref": "common.schema.json#/$defs/protocol"
    },
    "sphere": {
      "$ref": "common.schema.json#/$defs/sphere_id"
    },
    "obi": {
      "$ref": "common.schema.json#/$defs/obi_id"
    },
    "free": {
      "type": "boolean",
      "description": "Whether a job sent now would likely be accepted. It changes at most once every 15 minutes, with jitter, so it never says when the owner is at the Mac (protocol.md section 14)."
    },
    "slots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Jobs it runs at once."
    },
    "size": {
      "$ref": "common.schema.json#/$defs/box_size"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/agent"
      }
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "job",
          "review",
          "check"
        ]
      }
    },
    "for": {
      "oneOf": [
        {
          "const": "*"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/owner_id"
          }
        }
      ],
      "description": "The owners it is offered to, or every member (`*`)."
    },
    "free_at": {
      "$ref": "common.schema.json#/$defs/timestamp",
      "description": "When it expects to be free, when it isn't."
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp",
      "description": "At most 900 seconds after created_at."
    },
    "key_id": {
      "$ref": "common.schema.json#/$defs/key_id"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature",
      "description": "Ed25519 over \"obi/0.1 runner_status\\n\" and the canonical JSON of every other field."
    }
  }
}
