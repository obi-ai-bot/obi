{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/actions/handoff.schema.json",
  "title": "handoff body",
  "description": "Hand a piece of work to another Obi, which runs it for its own owner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "repo", "base_branch", "acceptance"],
  "properties": {
    "goal": { "$ref": "../common.schema.json#/$defs/line_text", "x-obi-text": "data", "minLength": 1, "maxLength": 200, "description": "The destination, one line." },
    "repo": { "$ref": "../common.schema.json#/$defs/repo" },
    "base_branch": { "$ref": "../common.schema.json#/$defs/branch" },
    "issue": { "$ref": "../common.schema.json#/$defs/issue_number" },
    "pr": { "$ref": "../common.schema.json#/$defs/pr_number" },
    "acceptance": { "$ref": "../common.schema.json#/$defs/acceptance" },
    "summary": { "$ref": "../common.schema.json#/$defs/block_text", "x-obi-text": "data", "minLength": 1, "maxLength": 2000 }
  }
}
