{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/actions/decline.schema.json",
  "title": "decline body",
  "description": "No to a request. Ends the exchange.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reason"],
  "properties": {
    "reason": { "enum": ["policy", "owner_declined", "busy", "expired", "out_of_scope", "other", "not_free", "share_used"] },
    "by_rule": { "$ref": "../common.schema.json#/$defs/rule_id", "description": "The remembered decision that declined it, when the owner was not asked." },
    "note": { "$ref": "../common.schema.json#/$defs/line_text", "x-obi-text": "data", "minLength": 1, "maxLength": 200 }
  }
}
