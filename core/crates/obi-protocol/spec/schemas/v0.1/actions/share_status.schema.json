{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/actions/share_status.schema.json",
  "title": "share_status body",
  "description": "How much of a share its receiver's owner has used this period, from the key holder's Obi: after each job on it, when it changes or resets, and at most hourly. Only in a share_offer's exchange.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant",
    "used_cents",
    "limit_cents",
    "resets"
  ],
  "properties": {
    "grant": {
      "$ref": "../common.schema.json#/$defs/grant_id"
    },
    "used_cents": {
      "$ref": "../common.schema.json#/$defs/cents"
    },
    "limit_cents": {
      "$ref": "../common.schema.json#/$defs/cents"
    },
    "resets": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    }
  }
}
