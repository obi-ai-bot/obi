#!/bin/sh
# A stand-in for Claude Code as obid's brain (`claude -p … --json-schema …`) in obid's tests.
# Run as a job's agent (no --json-schema), it is fake-claude.
#
# Its state is in its account's folder ($HOME/.fake-planner unboxed, else $HOME). Boxed (when the
# brain may read its quoted file) it can write nothing that outlives the call (#655: never its
# account's folder), so it asks the test's state server (support::planner_state), whose address
# is in `fake-planner-url` in a folder above its working folder.
#   plans        a queue, one line per call, the first taken each time:
#                  EXIT <code> <stderr…>   prints the words on stderr, nothing on stdout, exits
#                  PRINT <text>            prints the text as it is, and exits 0
#                  FAIL <code> <text>      prints the text as it is, and exits with the code
#                  SLEEP <seconds> <line>  waits, then does what the rest of the line says
#                  PEEK <path>             replies "read" when it could read the file, else "hidden"
#                  CHECK <repo>            dispatches tests in the repository, its `check` the first
#                                          `command` under its own instructions in work.md
#                  QUOTE <words>           replies with the first line of work.md holding the words
#                                          (any case) and the conversation found above it
#                  <plan>                  answers {"structured_output": <plan>}
#                When it's empty, the words the user says now choose (below).
#   calls/<n>/   what call n got: args (one per line), input (stdin), pwd, and work.md when
#                its directory had one.
case " $* " in
  *" --json-schema "*) ;;
  *) exec "$(dirname "$0")/fake-claude" "$@" ;;
esac
input=$(cat)
printf '%s\n' "$input" > "$HOME/plan-input"
# Unboxed, obid gives an account's brain a config folder of its own (#651), so the tests point at
# the account's folder from obid's HOME (support::start, \`.fake-planner\`).
url=""
if [ ! -d "$HOME/.fake-planner" ]; then
  d=$(pwd)
  while [ "$d" != / ]; do
    if [ -r "$d/fake-planner-url" ]; then url=$(cat "$d/fake-planner-url"); break; fi
    d=$(dirname "$d")
  done
fi
line=""
if [ -n "$url" ]; then
  line=$(printf '%s\n' "$input" | node "$(dirname "$0")/fake-planner-state.mjs" "$url" "$@")
else
  if [ -d "$HOME/.fake-planner" ]; then state=$HOME/.fake-planner; else state=$HOME; fi
  mkdir -p "$state/calls"
  until mkdir "$state/lock" 2>/dev/null; do sleep 0.05; done
  n=$(($(ls "$state/calls" | wc -l) + 1))
  call="$state/calls/$n"
  mkdir -p "$call"
  for arg in "$@"; do printf '%s\n' "$arg"; done > "$call/args"
  printf '%s\n' "$input" > "$call/input"
  pwd > "$call/pwd"
  [ -f work.md ] && cp work.md "$call/work.md"
  if [ -s "$state/plans" ]; then
    line=$(head -n 1 "$state/plans")
    tail -n +2 "$state/plans" > "$state/plans.next"
    mv "$state/plans.next" "$state/plans"
  fi
  rmdir "$state/lock"
fi
while :; do
  case "$line" in
    "SLEEP "*)
      rest=${line#SLEEP }
      sleep "${rest%% *}"
      line=${rest#* } ;;
    *) break ;;
  esac
done
case "$line" in
  "EXIT "*)
    set -- $line
    code=$2; shift 2
    [ $# -gt 0 ] && printf '%s\n' "$*" >&2
    exit "$code" ;;
  "PRINT "*) printf '%s\n' "${line#PRINT }"; exit 0 ;;
  "FAIL "*)
    rest=${line#FAIL }
    printf '%s\n' "${rest#* }"
    exit "${rest%% *}" ;;
  "PEEK "*)
    if cat "${line#PEEK }" >/dev/null 2>&1; then seen=read; else seen=hidden; fi
    line="{\"action\":\"reply_only\",\"reply\":\"$seen\",\"dispatches\":[],\"question\":null}" ;;
  "CHECK "*)
    repo=${line#CHECK }
    check=$(awk -v h="## $repo's own instructions (quoted)" '
      $0 == h { on = 1; next }
      on && /^## / { exit }
      on && match($0, /`[^`]+`/) { print substr($0, RSTART + 1, RLENGTH - 2); exit }' work.md 2>/dev/null)
    line="{\"action\":\"dispatch\",\"reply\":\"\",\"question\":null,\"jobs\":[],\"dispatches\":[{\"agent\":\"auto\",\"account\":\"auto\",\"repo\":\"$repo\",\"kind\":\"test\",\"title\":\"Run the tests\",\"task\":\"Run the tests\",\"rounds\":1,\"check\":\"$check\"}]}" ;;
  "QUOTE "*)
    found=$(awk -v w="${line#QUOTE }" '
      /^### Conversation / { c = $0; sub(/^### Conversation /, "", c) }
      index(tolower($0), tolower(w)) && !/^#/ && !/^Turn / { gsub(/"/, "'"'"'"); print c " said: " $0; exit }' work.md 2>/dev/null)
    line="{\"action\":\"reply_only\",\"reply\":\"${found:-nothing found}\",\"dispatches\":[],\"question\":null}" ;;
esac
if [ -n "$line" ]; then
  printf '{"structured_output":%s}\n' "$line"
  exit 0
fi
current=$(printf '%s\n' "$input" | sed -n '/The user says now:/,$p')
case "$current" in
  *none-case*) plan='{"action":"ignore","reply":"","dispatches":[],"question":null}' ;;
  *question-case*) plan='{"action":"ask_user","reply":"","dispatches":[],"question":{"text":"Which repository?","options":["obi-e2e/fixture-app"],"recommended":0}}' ;;
  *176*198*) plan='{"action":"dispatch","reply":"On it.","question":null,"dispatches":[{"repo":"obi-e2e/fixture-app","kind":"fix","task":"Fix #176","agent":"auto","account":"auto","issue":176,"rounds":1},{"repo":"obi-e2e/fixture-app","kind":"fix","task":"Fix #198","agent":"auto","account":"auto","issue":198,"rounds":1}]}' ;;
  *unsupported-case*) plan='{"action":"merge","reply":"","dispatches":[],"question":null}' ;;
  *slow-case*) sleep 3; plan='{"action":"reply_only","reply":"Late.","dispatches":[],"question":null}' ;;
  *) plan='{"action":"reply_only","reply":"Fine.","dispatches":[],"question":null}' ;;
esac
printf '{"structured_output":%s}\n' "$plan"
