#!/bin/sh
# A stand-in for Claude Code as obid's brain (`claude -p … --json-schema …`) in obid's tests.
# Run as a job's agent (no --json-schema), it is fake-claude.
#
# Its state is in its account's folder ($CLAUDE_CONFIG_DIR, else $HOME): the one place it can
# write both as it is and boxed (when the brain may read its quoted file).
#   plans        a queue, one line per call, the first taken each time:
#                  EXIT <code> <stderr…>   prints the words on stderr, nothing on stdout, exits
#                  PRINT <text>            prints the text as it is, and exits 0
#                  FAIL <code> <text>      prints the text as it is, and exits with the code
#                  SLEEP <seconds> <plan>  waits, then answers the plan
#                  PEEK <path>             replies "read" when it could read the file, else "hidden"
#                  <plan>                  answers {"structured_output": <plan>}
#                When it's empty, the words the user says now choose (below).
#   calls/<n>/   what call n got: args (one per line), input (stdin), pwd, and work.md when
#                its directory had one.
case " $* " in
  *" --json-schema "*) ;;
  *) exec "$(dirname "$0")/fake-claude" "$@" ;;
esac
input=$(cat)
printf '%s\n' "$input" > "$HOME/plan-input"
state=${CLAUDE_CONFIG_DIR:-$HOME}
mkdir -p "$state/calls"
until mkdir "$state/lock" 2>/dev/null; do sleep 0.05; done
n=$(($(ls "$state/calls" | wc -l) + 1))
call="$state/calls/$n"
mkdir -p "$call"
for arg in "$@"; do printf '%s\n' "$arg"; done > "$call/args"
printf '%s\n' "$input" > "$call/input"
pwd > "$call/pwd"
[ -f work.md ] && cp work.md "$call/work.md"
line=""
if [ -s "$state/plans" ]; then
  line=$(head -n 1 "$state/plans")
  tail -n +2 "$state/plans" > "$state/plans.next"
  mv "$state/plans.next" "$state/plans"
fi
rmdir "$state/lock"
case "$line" in
  "EXIT "*)
    set -- $line
    code=$2; shift 2
    [ $# -gt 0 ] && printf '%s\n' "$*" >&2
    exit "$code" ;;
  "PRINT "*) printf '%s\n' "${line#PRINT }"; exit 0 ;;
  "FAIL "*)
    rest=${line#FAIL }
    printf '%s\n' "${rest#* }"
    exit "${rest%% *}" ;;
  "PEEK "*)
    if cat "${line#PEEK }" >/dev/null 2>&1; then seen=read; else seen=hidden; fi
    line="{\"action\":\"reply_only\",\"reply\":\"$seen\",\"dispatches\":[],\"question\":null}" ;;
  "SLEEP "*)
    rest=${line#SLEEP }
    sleep "${rest%% *}"
    line=${rest#* } ;;
esac
if [ -n "$line" ]; then
  printf '{"structured_output":%s}\n' "$line"
  exit 0
fi
current=$(printf '%s\n' "$input" | sed -n '/The user says now:/,$p')
case "$current" in
  *none-case*) plan='{"action":"ignore","reply":"","dispatches":[],"question":null}' ;;
  *question-case*) plan='{"action":"ask_user","reply":"","dispatches":[],"question":{"text":"Which repository?","options":["obi-e2e/fixture-app"],"recommended":0}}' ;;
  *176*198*) plan='{"action":"dispatch","reply":"On it.","question":null,"dispatches":[{"repo":"obi-e2e/fixture-app","kind":"fix","task":"Fix #176","agent":"auto","account":"auto","issue":176,"rounds":1},{"repo":"obi-e2e/fixture-app","kind":"fix","task":"Fix #198","agent":"auto","account":"auto","issue":198,"rounds":1}]}' ;;
  *unsupported-case*) plan='{"action":"merge","reply":"","dispatches":[],"question":null}' ;;
  *slow-case*) sleep 3; plan='{"action":"reply_only","reply":"Late.","dispatches":[],"question":null}' ;;
  *) plan='{"action":"reply_only","reply":"Fine.","dispatches":[],"question":null}' ;;
esac
printf '{"structured_output":%s}\n' "$plan"
