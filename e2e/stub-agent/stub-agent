#!/usr/bin/env node
// stub-agent: a deterministic stand-in for Claude Code in the end-to-end test (e2e/SCENARIO.md,
// "The stub agent"). obid runs it exactly as it runs `claude`: the same flags, stream-json in and
// out, in the job's worktree. It needs no model and no credentials, writes nothing (one probe aside, below, which a working sandbox refuses), and reviews
// the fixture repository by fixed rules, so the same worktree always gives the same two findings.
//
// It also checks the parts of obid's side of the contract it can see, and fails the turn (an
// error result, exit 3) when one breaks:
//   - the prompt is not empty and holds no data text from the request (the canary);
//   - the request reached it as a quoted file, .obi/inputs/obi-request.json, holding the canary;
//   - the worktree's HEAD is the request's head_sha;
//   - no CLAUDECODE, CLAUDE_CODE_*, ANTHROPIC_*, GH_TOKEN or GITHUB_TOKEN in its environment;
//   - it runs in obid's job sandbox: creating a file in the folder that holds its worktree (obid's
//     home/worktrees/) fails. If it succeeds, the stub removes the file at once and fails the turn.
//     OBI_STUB_NO_SANDBOX=1 skips this one check; only the harness's preflight sets it, when it runs
//     the stub alone with no sandbox. The harness never gives it to obid, so obid's agents never have it.

import { execFileSync } from "node:child_process";
import { createHash } from "node:crypto";
import { existsSync, readFileSync, unlinkSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { createInterface } from "node:readline";

const VERSION = "0.1.0 (stub-agent; Claude Code stream-json compatible)";
const CANARY = "OBI-E2E-DATA-CANARY";
const RULES = [
  {
    file: "src/average.js",
    match: /^\s*return total \/ values\.length;\s*$/,
    severity: "major",
    title: "average() divides by zero for an empty list",
    detail: "average([]) returns NaN: values.length is 0, so the division has no meaning. Return 0 or throw a clear error for an empty list, and add a test for it.",
  },
  {
    file: "src/greet.js",
    match: /^\s*const trimmed = name\.trim\(\);\s*$/,
    severity: "minor",
    title: "Unused variable `trimmed`",
    detail: "greet() computes trimmed but still greets with name, so the trim has no effect. Use trimmed in the greeting, or remove the line.",
  },
];

const argv = process.argv.slice(2);
if (argv.includes("--version") || argv.includes("-v")) {
  process.stdout.write(`${VERSION}\n`);
  process.exit(0);
}
const valueOf = (name) => (argv.includes(name) ? argv[argv.indexOf(name) + 1] : undefined);
if (!(argv.includes("-p") || argv.includes("--print")) || valueOf("--input-format") !== "stream-json" || valueOf("--output-format") !== "stream-json") {
  process.stderr.write("stub-agent: run me as obid runs claude: -p --input-format stream-json --output-format stream-json\n");
  process.exit(64);
}
const structured = argv.includes("--json-schema");

const cwd = process.cwd();
const emit = (line) => process.stdout.write(JSON.stringify(line) + "\n");

function promptText(message) {
  const content = message?.message?.content;
  if (typeof content === "string") return content;
  if (Array.isArray(content)) return content.filter((b) => b?.type === "text").map((b) => b.text).join("\n");
  return "";
}

function problems(prompt, request) {
  const found = [];
  if (!prompt.trim()) found.push("the prompt is empty");
  if (prompt.includes(CANARY)) found.push("data text from the request is in the prompt (it must only be in .obi/inputs/obi-request.json)");
  for (const name of Object.keys(process.env)) {
    if (name === "CLAUDECODE" || (name.startsWith("CLAUDE_CODE_") && name !== "CLAUDE_CODE_TMPDIR") || name.startsWith("ANTHROPIC_") || name === "GH_TOKEN" || name === "GITHUB_TOKEN") found.push(`${name} is in the agent's environment`);
  }
  if (process.env.OBI_STUB_NO_SANDBOX !== "1") {
    const probe = join(dirname(cwd), `.obi-stub-sandbox-probe-${process.pid}`);
    let wrote = false;
    try {
      writeFileSync(probe, "", { flag: "wx" });
      wrote = true;
    } catch {}
    if (wrote) {
      try {
        unlinkSync(probe);
      } catch {}
      found.push(`the agent could write outside its worktree (${dirname(cwd)}): no job sandbox`);
    }
  }
  if (!request) {
    found.push(".obi/inputs/obi-request.json is missing or isn't JSON");
    return found;
  }
  if (request.type !== "review_request" || typeof request.body !== "object") found.push(".obi/inputs/obi-request.json is not a review_request");
  else {
    if (!JSON.stringify(request.body).includes(CANARY)) found.push("the request's data text didn't reach the agent as a file");
    let head = "";
    try {
      head = execFileSync("git", ["rev-parse", "HEAD"], { cwd, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
    } catch {
      found.push("the working directory is not a git worktree");
    }
    if (head && head !== request.body.head_sha) found.push(`HEAD is ${head}, not the request's head_sha ${request.body.head_sha}`);
  }
  return found;
}

function review() {
  const findings = [];
  for (const rule of RULES) {
    const path = join(cwd, rule.file);
    if (!existsSync(path)) continue;
    const lines = readFileSync(path, "utf8").split("\n");
    const index = lines.findIndex((line) => rule.match.test(line));
    if (index >= 0) findings.push({ severity: rule.severity, file: rule.file, line: index + 1, title: rule.title, detail: rule.detail });
  }
  return findings;
}

function readRequest() {
  try {
    return JSON.parse(readFileSync(join(cwd, ".obi", "inputs", "obi-request.json"), "utf8"));
  } catch {
    return null;
  }
}

let turns = 0;
let session = null;
const rl = createInterface({ input: process.stdin, crlfDelay: Infinity });
rl.on("line", (line) => {
  let message;
  try {
    message = JSON.parse(line);
  } catch {
    return;
  }
  if (message?.type !== "user") return;
  turns++;
  const prompt = promptText(message);
  const request = readRequest();
  const head = request?.body?.head_sha ?? "unknown";
  session ??= (() => {
    const h = createHash("sha256").update(`stub-agent:${cwd}:${head}`).digest("hex");
    return `${h.slice(0, 8)}-${h.slice(8, 12)}-4${h.slice(13, 16)}-8${h.slice(17, 20)}-${h.slice(20, 32)}`;
  })();
  if (turns === 1) {
    emit({ type: "system", subtype: "init", cwd, session_id: session, tools: ["Read", "Grep", "Glob"], mcp_servers: [], model: "stub-agent", permissionMode: "default", apiKeySource: "none", claude_code_version: "stub-0.1.0" });
  }
  const wrong = problems(prompt, request);
  if (wrong.length) {
    emit({ type: "result", subtype: "error_during_execution", is_error: true, duration_ms: 0, num_turns: turns, result: `stub-agent: ${wrong.join("; ")}`, session_id: session, total_cost_usd: 0 });
    process.exitCode = 3;
    rl.close();
    return;
  }
  const findings = review();
  emit({
    type: "assistant", session_id: session, parent_tool_use_id: null,
    message: { id: `msg_stub_${turns}`, type: "message", role: "assistant", model: "stub-agent", content: [{ type: "text", text: `Reviewing ${request.body.head_branch} at ${head.slice(0, 7)} against ${request.body.base_branch}.` }], stop_reason: null, usage: { input_tokens: 0, output_tokens: 0 } },
  });
  const summary = findings.length === 2
    ? "Two findings, no blocker: an empty list breaks average(), and greet() has an unused variable."
    : `${findings.length} finding(s).`;
  const text = [`Review of ${head}: ${findings.length} finding(s).`, "", ...findings.map((f) => `- ${f.severity} ${f.file}:${f.line} ${f.title}`)].join("\n");
  emit({
    type: "result", subtype: "success", is_error: false, duration_ms: 0, duration_api_ms: 0, num_turns: turns,
    result: text, session_id: session, total_cost_usd: 0, usage: { input_tokens: 0, output_tokens: 0 },
    ...(structured ? { structured_output: { summary, findings } } : {}),
  });
});
rl.on("close", () => process.exit(process.exitCode ?? 0));
