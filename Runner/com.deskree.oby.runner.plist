<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Oby's runner on this Mac (#283), as a login item: the Oby app registers it with SMAppService
     (Mac/LoginItem.swift), and launchd starts Contents/Helpers/oby-runner at login and keeps it
     running while the app's window is closed. The Xcode build bundles this file at
     Contents/Library/LaunchAgents and the executable at Contents/Helpers (the "Bundle the runner"
     phase of the Oby target). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.deskree.oby.runner</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/oby-runner</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.deskree.oby</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>OBY_PORT</key>
		<string>7777</string>
	</dict>
</dict>
</plist>
