# Copy to .dev.vars for `wrangler dev` (git ignores it). Nothing here is real: placeholders only.
# In production, each is a Worker secret: `wrangler secret put <NAME>` (docs/remote-access.md).

# A Cloudflare API token with Cloudflare Tunnel: Edit on the account and DNS: Edit on the zone.
CF_API_TOKEN=paste-the-api-token-here
CF_ACCOUNT_ID=paste-the-account-id-here
CF_ZONE_ID=paste-the-device-domain-zone-id-here

