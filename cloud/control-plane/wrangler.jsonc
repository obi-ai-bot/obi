// Oby's control plane (#285): a Worker with a D1 database. Anyone may run their own; each instance
// is a named environment below, deployed with `pnpm run deploy --env <name>` (docs/remote-access.md,
// "Run your own control plane"). The top level is the template every environment starts from, with
// nothing instance-specific: on its own it signs nobody in (every sign-in answers 503).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oby-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Workers Logs keep what the code logs, and no invocation logs: those record every request's
  // URL, headers and address, which would tie a Mac's signed calls (its Oby-Key) to the pushes it
  // sends the push relay from the same address (#398).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Every minute: spent nonces, old rate-limit windows and deliveries kept 72 hours go, installations with no endpoint
  // after a day, installations idle for 30 days with their tunnels, and tunnels not kept
  // connected (src/app.ts, `sweep`).
  "triggers": { "crons": ["* * * * *"] },
  // Plain settings, every one documented in src/env.ts. Secrets (the Cloudflare API token, the
  // account and zone ids, the APNs key and PUSH_SECRET_KEY) are never here: `wrangler secret put --env <name>`, or .dev.vars for
  // `wrangler dev`. Wrangler doesn't inherit `vars` or `d1_databases`: an environment lists them all.
  "vars": {
    "PRODUCT_DOMAIN": "",
    "DEVICE_DOMAIN": "",
    "MEMBER_WORKSPACES": "",
    "HOSTNAME_PREFIX": "oby-",
    "APPLE_CLIENT_ID": "",
    "APPLE_REDIRECT_URI": "",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_REDIRECT_URI": "",
    "WORKSPACE_DOMAIN_ENDPOINTS": "100",
    "WORKSPACE_DOMAIN_REGISTRATIONS": "50",
    "MAX_ENDPOINTS": "500",
    "GATEWAY": "http://127.0.0.1:8810",
    "QUEUE_TOTAL_MIB": "200",
    "APNS_TOPICS": "",
    "MAX_PUSH_DEVICES": "100000"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "oby-control", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "env": {
    // Deskree's own instance, for Deskree's people only: oby-control.deskree.com in Deskree's
    // Cloudflare account. Copy this block, rename it and put your own values in to run yours.
    "deskree": {
      "name": "oby-control",
      // As at the top: no invocation logs.
      "observability": { "enabled": true, "logs": { "invocation_logs": false } },
      // The Worker's own hostname, a first-level name under the zone so Universal SSL covers it.
      "routes": [{ "pattern": "oby-control.deskree.com", "custom_domain": true }],
      "vars": {
        "PRODUCT_DOMAIN": "deskree.com",
        // Members-only (MEMBER_WORKSPACES), so the Macs' hostnames may live under deskree.com
        // itself: only Deskree's own Google Workspace accounts get one.
        "DEVICE_DOMAIN": "deskree.com",
        "MEMBER_WORKSPACES": "deskree.com",
        "HOSTNAME_PREFIX": "oby-",
        // Members-only refuses Apple, which has no Workspace; kept for when that changes.
        "APPLE_CLIENT_ID": "com.deskree.oby.signin",
        "APPLE_REDIRECT_URI": "https://oby-control.deskree.com/v1/auth/apple/callback",
        // The "Oby remote access" Web client in Google Cloud project oby-remote-access (deskree.com
        // organization, consent screen Internal). Public: the ID token flow uses no client secret.
        "GOOGLE_CLIENT_ID": "578493178552-e166j16pbst6jhrbend0cgtkndmctqr9.apps.googleusercontent.com",
        "GOOGLE_REDIRECT_URI": "https://oby-control.deskree.com/v1/auth/google/callback",
        "WORKSPACE_DOMAIN_ENDPOINTS": "100",
        "WORKSPACE_DOMAIN_REGISTRATIONS": "50",
        "MAX_ENDPOINTS": "500",
        "GATEWAY": "http://127.0.0.1:8810",
        // The most bytes of sealed deliveries kept for every Mac away together (#1315), in MiB.
        // D1's free plan holds 500 MB a database, so this leaves room for everything else.
        "QUEUE_TOTAL_MIB": "200",
        // The sealed push relay (#398): the iPhone app's bundle id (#1350), and the most phones
        // registered at once (about 200 bytes each in D1).
        "APNS_TOPICS": "com.deskree.oby.ios",
        "MAX_PUSH_DEVICES": "100000"
      },
      "d1_databases": [
        // Made by `wrangler d1 create oby-control` in Deskree's account on 2026-10-22.
        { "binding": "DB", "database_name": "oby-control", "database_id": "a0c20945-43b9-4090-ad09-753de05d76c3", "migrations_dir": "migrations" }
      ]
    }
  }
}
