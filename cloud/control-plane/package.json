{
  "name": "oby-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Oby's control plane on Cloudflare: sign-in, installations and one tunnel per Mac.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "vitest run --config worker.vitest.ts",
    "suffixes": "node scripts/suffixes.mjs",
    "migrate:local": "wrangler d1 migrations apply oby-control --local",
    "migrate:remote": "wrangler d1 migrations apply oby-control --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
